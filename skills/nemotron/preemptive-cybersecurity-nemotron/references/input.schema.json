{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PCS analysis input v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "service": {
          "type": "string",
          "minLength": 1
        },
        "business_impact": {
          "type": "string",
          "minLength": 1
        },
        "window_start": {
          "type": "string",
          "minLength": 1
        },
        "window_end": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "authorization": {
          "enum": [
            "analysis_only",
            "authorized_testing"
          ]
        },
        "approved_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "test_window": {
          "type": [
            "string",
            "null"
          ]
        },
        "stop_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rollback_owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "scope_id",
        "service",
        "business_impact",
        "window_start",
        "window_end",
        "timezone",
        "authorization",
        "approved_actions",
        "test_window",
        "stop_conditions",
        "rollback_owner",
        "constraints"
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "criticality": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "asset_id",
          "name",
          "criticality",
          "owner",
          "version",
          "observed_at"
        ]
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "signal_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "collected_at": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "signal_id",
          "description",
          "source",
          "observed_at",
          "collected_at"
        ]
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "control_id": {
            "type": "string",
            "minLength": 1
          },
          "asset_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "control_id",
          "asset_ids",
          "description",
          "evidence_id"
        ]
      }
    },
    "exposures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "exposure_id": {
            "type": "string",
            "minLength": 1
          },
          "asset_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "type": {
            "enum": [
              "vulnerability",
              "configuration",
              "identity",
              "reachability",
              "other"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "hypothesis",
              "observed",
              "validated"
            ]
          }
        },
        "required": [
          "exposure_id",
          "asset_ids",
          "type",
          "description",
          "observed_at",
          "evidence_ids",
          "status"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "collected_at": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "evidence_id",
          "source",
          "locator",
          "observed_at",
          "collected_at",
          "description"
        ]
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "observed",
              "hypothesis"
            ]
          }
        },
        "required": [
          "from",
          "to",
          "relation",
          "evidence_ids",
          "status"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "scope",
    "assets",
    "signals",
    "controls",
    "exposures",
    "evidence",
    "relationships"
  ]
}
